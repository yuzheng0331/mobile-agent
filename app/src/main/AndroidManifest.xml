<?xml version="1.0" encoding="utf-8"?>
<!-- No INTERNET permission yet: nothing connects. When added, it is only for app updates, packs, and the own-site APIs a pack declares; screen content never goes out. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background role mode (Background): granted only while we hold the app streaming role. -->
    <uses-permission android:name="android.permission.ADD_TRUSTED_DISPLAY" />
    <uses-permission android:name="android.permission.ADD_ALWAYS_UNLOCKED_DISPLAY" />

    <!-- Package visibility (Android 11+): only the apps the packs may launch. -->
    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="com.tencent.mobileqq" />
        <package android:name="com.xingin.xhs" />
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.quark.browser" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AgentService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/agent_service" />
        </service>

        <!-- Background mode: the shell server (shell.ShellServer) hands its binder over here. Exported so
             the shell user can reach it; ShellProvider ignores every other caller. -->
        <provider
            android:name=".shell.ShellProvider"
            android:authorities="dev.phoneagent.app.shell"
            android:exported="true" />

        <!-- No keyboard, never types: selected during OCR runs only, for all CPU cores (AgentIme). -->
        <service
            android:name=".AgentIme"
            android:exported="true"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/agent_ime" />
        </service>
    </application>
</manifest>
