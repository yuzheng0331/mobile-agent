{
  "schemaVersion": 1,
  "id": "quark-first-bookmark",
  "version": "0.2.0",
  "author": "phone-agent",
  "aliases": ["打开夸克书签网站", "夸克打开书签"],
  "requires": ["com.quark.browser"],
  "steps": [
    {"do": "launch", "app": "com.quark.browser", "expect": {"anyText": ["多窗口"], "gone": ["返回主页"]}},
    {"do": "tap",
     "target": {"intent": "首页名为“书签”的网站快捷方式", "find": [{"text": "书签", "exact": true}]},
     "expect": {"anyText": ["返回主页"]},
     "ifMissing": "夸克首页没有名为“书签”的网站：请先把网站添加到首页并命名为“书签”"}
  ]
}
